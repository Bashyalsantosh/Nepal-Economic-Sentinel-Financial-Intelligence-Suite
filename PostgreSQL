-- =============================================================================
-- Nepal Economic Sentinel & Financial Intelligence Suite
-- Database DDL Initialization Script (PostgreSQL 14+)
-- =============================================================================

BEGIN;

-- 1. SCHEMAS CREATION
CREATE SCHEMA IF NOT EXISTS silver;
CREATE SCHEMA IF NOT EXISTS gold;

-- -----------------------------------------------------------------------------
-- 2. SILVER LAYER TABLES (Cleaned & Structured Data)
-- -----------------------------------------------------------------------------

-- 2.1 NRB Forex Rates Table
CREATE TABLE IF NOT EXISTS silver.nrb_forex_rates (
    rate_date      DATE NOT NULL,
    currency_iso3  VARCHAR(3) NOT NULL,
    currency_name  VARCHAR(100) NOT NULL,
    currency_unit  INTEGER NOT NULL CHECK (currency_unit > 0),
    buying_rate    NUMERIC(12, 4) NOT NULL CHECK (buying_rate >= 0),
    selling_rate   NUMERIC(12, 4) NOT NULL CHECK (selling_rate >= 0),
    ingested_at    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    
    CONSTRAINT pk_silver_nrb_forex PRIMARY KEY (rate_date, currency_iso3)
);

-- Index for date-range macro searches
CREATE INDEX IF NOT EXISTS idx_nrb_forex_date 
    ON silver.nrb_forex_rates (rate_date DESC);

COMMENT ON TABLE silver.nrb_forex_rates IS 'Cleaned daily exchange rates from Nepal Rastra Bank (NRB).';


-- 2.2 NEPSE Daily Floorsheet Trades Table
CREATE TABLE IF NOT EXISTS silver.nepse_floorsheet_trades (
    contract_id    VARCHAR(64) NOT NULL,
    trade_date     DATE NOT NULL,
    symbol         VARCHAR(20) NOT NULL,
    buyer_broker   INTEGER NOT NULL,
    seller_broker  INTEGER NOT NULL,
    quantity       BIGINT NOT NULL CHECK (quantity > 0),
    rate           NUMERIC(12, 2) NOT NULL CHECK (rate >= 0),
    total_amount   NUMERIC(16, 2) NOT NULL CHECK (total_amount >= 0),
    trade_time_str VARCHAR(20),
    processed_at   TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    
    CONSTRAINT pk_silver_nepse_trades PRIMARY KEY (contract_id, trade_date)
);

-- Performance Indexes for aggregation and joins
CREATE INDEX IF NOT EXISTS idx_nepse_trades_date_symbol 
    ON silver.nepse_floorsheet_trades (trade_date DESC, symbol);

CREATE INDEX IF NOT EXISTS idx_nepse_trades_buyer 
    ON silver.nepse_floorsheet_trades (buyer_broker, trade_date);

CREATE INDEX IF NOT EXISTS idx_nepse_trades_seller 
    ON silver.nepse_floorsheet_trades (seller_broker, trade_date);

COMMENT ON TABLE silver.nepse_floorsheet_trades IS 'Deduplicated and structured trade execution ticks from NEPSE floorsheet.';


-- -----------------------------------------------------------------------------
-- 3. GOLD LAYER TABLES & VIEWS (Intelligence & Analytics)
-- -----------------------------------------------------------------------------

-- 3.1 Broker Daily Summary Table (Intermediate Aggregate for ML / Anomaly Detection)
CREATE TABLE IF NOT EXISTS gold.fact_daily_broker_summary (
    trade_date    DATE NOT NULL,
    buyer_broker  INTEGER NOT NULL,
    seller_broker INTEGER NOT NULL,
    symbol        VARCHAR(20) NOT NULL,
    total_volume  BIGINT NOT NULL,
    total_amount  NUMERIC(18, 2) NOT NULL,
    trade_count   INTEGER NOT NULL,
    created_at    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT pk_gold_broker_summary PRIMARY KEY (trade_date, buyer_broker, seller_broker, symbol)
);

CREATE INDEX IF NOT EXISTS idx_gold_broker_summary_date 
    ON gold.fact_daily_broker_summary (trade_date DESC);


-- 3.2 Financial Intelligence Risk & Anomaly Alerts Table
CREATE TABLE IF NOT EXISTS gold.sentinel_risk_alerts (
    alert_id      BIGINT GENERATED ALWAYS AS IDENTITY,
    alert_date    DATE NOT NULL,
    alert_type    VARCHAR(50) NOT NULL, -- e.g. 'SUSPICIOUS_VOLUME_SPIKE', 'WASH_TRADE_PATTERN'
    broker_id     INTEGER NOT NULL,
    symbol        VARCHAR(20),
    risk_score    NUMERIC(5, 4) NOT NULL CHECK (risk_score BETWEEN 0.0000 AND 1.0000),
    details       TEXT,
    is_reviewed   BOOLEAN DEFAULT FALSE,
    created_at    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT pk_gold_sentinel_alerts PRIMARY KEY (alert_id),
    CONSTRAINT uq_sentinel_alert_record UNIQUE (alert_date, alert_type, broker_id, symbol)
);

-- Index for real-time alerting queries and Streamlit dashboards
CREATE INDEX IF NOT EXISTS idx_sentinel_alerts_unreviewed 
    ON gold.sentinel_risk_alerts (alert_date DESC, is_reviewed) 
    WHERE is_reviewed = FALSE;

COMMENT ON TABLE gold.sentinel_risk_alerts IS 'AML and market abuse risk signals generated by ML anomaly engines.';

COMMIT;
